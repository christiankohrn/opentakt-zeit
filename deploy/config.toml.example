environment = "development"
secret_key = "change-me"
timezone = "Europe/Berlin"
org_name = "Muster GmbH"
public_url = "https://zeiterfassung.example.de"
bundesland = "NW"
database_path = "/var/lib/zeiterfassung/app.db"
listen_host = "127.0.0.1"
listen_port = 8000

[seed]
admin_username = "admin"
admin_password = "change-me"
hr_username = "personal"
hr_password = "change-me"
employee_username = "mitarbeiter"
employee_password = "change-me"
shift_username = "erika"
shift_password = "change-me"

[smtp]
enabled = false
host = ""
port = 587
username = ""
password = ""
from_addr = ""
use_tls = true
use_ssl = false

[ldap]
enabled = false
url = "ldap://dc.example.local"
bind_dn = ""
bind_password = ""
user_base = "OU=Users,DC=example,DC=local"
user_filter = "(sAMAccountName={username})"
group_hr = ""
group_admin = ""

# Shared secret for Datafox MasterIV HTTP. Empty = Terminal-API ist aus.
# In der Send-URL als ?k=... eintragen, niemals ins Git.
datafox_secret = ""
